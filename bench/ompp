#!/bin/sh
set -e

CONFIG_DIR_MODE="shared"      # shared, isolated, anywhere
EXEC_MODE="dist"              # dist (bundle), src (source)
MODE="auto"                   # auto, daemon, cli, client
AUTO_DAEMON="yes"             # yes, no - whether to auto-start daemon
LAZY_MODE=false
CUSTOM_PRELOAD=""
CUSTOM_CONFIG_DIR=""

usage() {
    cat << EOF
Usage: $0 [OPTIONS]

Modes:
  (default)         Run as thin client; start daemon if needed
  --mode daemon     Start daemon explicitly
  --mode cli        Direct CLI execution (no daemon)
  --mode client     Thin client only (fail if daemon not running)

Config directories:
  (default)         Shared config (~/.omp)
  --isolated        Isolated config (.ompp)
  --anywhere        Global install with ~/.ompp-anywhere

Execution:
  (default)         Use bundled dist/cli.js
  --source          Use source TypeScript (src/cli.ts)
  --lazy            Enable MCP lazy-connect for source mode

Other options:
  --config-dir DIR  Override config directory
  --preload FILE    Custom preload script
  --help            Show this help

Environment:
  OMP_DEV_LAUNCH_DIR  Override launch directory
  OMP_CONFIG_DIR      Override config directory
  OMP_DAEMON_TUI=1    Serve TUI over daemon socket
EOF
}

ORIG_ARGS="$*"
ORIG_ARGC=$#
DAEMON_PASSTHROUGH=false
case " $ORIG_ARGS " in
    *" --mode daemon "*|*" --mode=daemon "*|*" --mode daemon"|*" --mode=daemon")
        DAEMON_PASSTHROUGH=true
        ;;
esac
while [ $# -gt 0 ]; do
    case "$1" in
        --mode)
            shift
            MODE="$1"
            ;;
        --mode=*)
            MODE="${1#*=}"
            ;;
        --config-dir)
            shift
            CUSTOM_CONFIG_DIR="$1"
            ;;
        --config-dir=*)
            CUSTOM_CONFIG_DIR="${1#*=}"
            ;;
        --preload)
            shift
            CUSTOM_PRELOAD="$1"
            ;;
        --preload=*)
            CUSTOM_PRELOAD="${1#*=}"
            ;;
        --isolated)
            CONFIG_DIR_MODE="isolated"
            AUTO_DAEMON="no"
            ;;
        --anywhere)
            CONFIG_DIR_MODE="anywhere"
            AUTO_DAEMON="no"
            ;;
        --source)
            EXEC_MODE="src"
            ;;
        --lazy)
            LAZY_MODE=true
            EXEC_MODE="src"
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            REMAINING="$*"
            break
            ;;
    esac
    shift
done

self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case $link in
        /*) self=$link ;;
        *) self=$(dirname "$self")/$link ;;
    esac
done
bench_dir=$(CDPATH= cd -- "$(dirname -- "$self")" && pwd -P)
# Re-execs "$self" after cd to launch_dir — relative $0 would break.
self=$bench_dir/$(basename -- "$self")
pkg_dir=$bench_dir/../packages/coding-agent

case "$EXEC_MODE" in
    dist)
        cli="$pkg_dir/dist/cli.js"
        preload="${CUSTOM_PRELOAD:-$pkg_dir/scripts/omp.ts}"
        ;;
    src)
        cli="$pkg_dir/src/cli.ts"
        preload="${CUSTOM_PRELOAD:-$pkg_dir/scripts/omp.ts}"
        if [ "$LAZY_MODE" = true ]; then
            export OMP_MCP_LAZY="1"
        fi
        ;;
esac
# ompp-local checks this; fail early with a clear message.
if [ "$EXEC_MODE" = "dist" ] && [ ! -f "$cli" ]; then
    echo "ompp: dist/cli.js not found. Run 'bun run gen:bundle' first." >&2
    exit 1
fi

case "$CONFIG_DIR_MODE" in
    shared)
        :
        ;;
    isolated)
        export PI_CONFIG_DIR=".ompp"
        ;;
    anywhere)
        OMPP_HOME="${HOME}/.bun/install/global/node_modules/@oh-my-pi/pi-coding-agent"
        if [ ! -f "$OMPP_HOME/dist/cli.js" ]; then
            echo "ompp-anywhere: pi-coding-agent not found. Install with:" >&2
            echo "  bun install -g @oh-my-pi/pi-coding-agent" >&2
            exit 1
        fi
        cli="$OMPP_HOME/dist/cli.js"
        _anywhere_preload="${OMPP_HOME}/scripts/omp.ts"
        if [ -f "$_anywhere_preload" ]; then
            preload="${CUSTOM_PRELOAD:-$_anywhere_preload}"
        else
            preload=""
        fi
        export PI_CONFIG_DIR="${HOME}/.ompp-anywhere"
        OMP_HOME="$OMPP_HOME"
        # NODE_PATH from installed OMP's node_modules
        export NODE_PATH="${OMP_HOME}:${OMP_HOME}/pi-natives:${OMP_HOME}/pi-ai:${OMP_HOME}/pi-utils:${OMP_HOME}/pi-coding-agent/node_modules"
        ;;
esac

# NODE_PATH per mode: ompp-local uses ~/.ompp, ompp-lazy uses global install.
if [ "$CONFIG_DIR_MODE" = "isolated" ] && [ "$EXEC_MODE" = "dist" ]; then
    OMP_HOME="${HOME}/.ompp"
    export NODE_PATH="${OMP_HOME}:${OMP_HOME}/natives:${OMP_HOME}/pi-natives:${OMP_HOME}/pi-ai:${OMP_HOME}/pi-utils:${OMP_HOME}/pi-coding-agent/node_modules"
elif [ "$CONFIG_DIR_MODE" = "isolated" ] && [ "$EXEC_MODE" = "src" ]; then
    OMP_HOME="${HOME}/.bun/install/global/node_modules/@oh-my-pi"
    export NODE_PATH="${OMP_HOME}:${OMP_HOME}/pi-natives:${OMP_HOME}/pi-ai:${OMP_HOME}/pi-utils:${OMP_HOME}/pi-coding-agent/node_modules"
fi

if [ -n "$CUSTOM_CONFIG_DIR" ]; then
    export PI_CONFIG_DIR="$CUSTOM_CONFIG_DIR"
fi

export OMP_APP_NAME="omp"

case "$CONFIG_DIR_MODE" in
    shared)   launch_dir=${OMP_DEV_LAUNCH_DIR:-${HOME}/.omp/.dev-cwd} ;;
    isolated) launch_dir=${OMP_DEV_LAUNCH_DIR:-${HOME}/.ompp/.dev-cwd} ;;
    anywhere) launch_dir="" ;;
esac

# anywhere mode: no launch_dir, no OMP_LAUNCH_CWD, no cd (matches original).
if [ -n "$launch_dir" ]; then
    OMP_LAUNCH_CWD=$PWD
    export OMP_LAUNCH_CWD
    mkdir -p "$launch_dir"
    cd "$launch_dir"
fi

SOCK="/tmp/omp-daemon/${OMP_APP_NAME}-$(id -u).sock"

daemon_alive() {
    [ -S "$SOCK" ] && node -e 'require("net").connect(process.argv[1]).on("connect",()=>process.exit(0)).on("error",()=>process.exit(1))' "$SOCK" 2>/dev/null
}

lock_stale() {
    if [ -f "${SOCK}.lock/pid" ]; then
        pid=$(cat "${SOCK}.lock/pid" 2>/dev/null)
        [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && return 1
        return 0
    fi
    [ -n "$(find "${SOCK}.lock" -maxdepth 0 -mmin +1 2>/dev/null)" ]
}

acquire_lock() {
    if mkdir "${SOCK}.lock" 2>/dev/null; then
        echo $$ >"${SOCK}.lock/pid" 2>/dev/null || true
        return 0
    fi
    lock_stale || return 1
    rm -rf "${SOCK}.lock"
    mkdir "${SOCK}.lock" 2>/dev/null || return 1
    echo $$ >"${SOCK}.lock/pid" 2>/dev/null || true
}

run_bun() {
    if [ -n "$preload" ]; then
        exec bun --preload "$preload" "$cli" "$@"
    else
        exec bun "$cli" "$@"
    fi
}

if [ "$DAEMON_PASSTHROUGH" = true ] || [ "$MODE" = "daemon" ]; then
    run_bun $ORIG_ARGS
elif [ "$MODE" = "cli" ]; then
    run_bun $REMAINING
elif [ "$MODE" = "client" ]; then
    if ! daemon_alive; then
        echo "omp: daemon not running at $SOCK" >&2
        exit 1
    fi
    exec node "$bench_dir/tui-client.cjs" "$SOCK"
else
    if [ "$ORIG_ARGC" -eq 0 ] && [ "$AUTO_DAEMON" = "yes" ]; then
        if ! daemon_alive; then
            mkdir -p "$(dirname "$SOCK")"
            if acquire_lock; then
                OMP_DAEMON_TUI="${OMP_DAEMON_TUI:-1}" node -e 'const fs=require("fs");const log=fs.openSync("/tmp/omp-daemon.log","w");require("child_process").spawn("bash",[process.argv[1],"--mode","daemon"],{stdio:["ignore",log,log],detached:true}).unref()' "$self"
                for _ in $(seq 1 80); do daemon_alive && break; sleep 0.5; done
                rm -rf "${SOCK}.lock"
            else
                for _ in $(seq 1 120); do daemon_alive && break; sleep 0.5; done
            fi
            daemon_alive || { echo "ompp: daemon failed to start; see /tmp/omp-daemon.log" >&2; exit 1; }
        fi
        exec node "$bench_dir/tui-client.cjs" "$SOCK"
    else
        run_bun $REMAINING
    fi
fi
