#!/bin/sh
# ompp - Modified OMP with lazy MCP startup
# Uses PI_CONFIG_DIR=.ompp for complete isolation from main omp
set -e

# Resolve this script's real location
self=$0
while [ -L "$self" ]; do
	link=$(readlink "$self")
	case $link in
	/*) self=$link ;;
	*) self=$(dirname "$self")/$link ;;
	esac
done
bench_dir=$(CDPATH= cd -- "$(dirname -- "$self")" && pwd -P)
pkg_dir=$bench_dir/../packages/coding-agent
cli=$pkg_dir/src/cli.ts
preload=$pkg_dir/scripts/omp.ts

# Use separate config directory
export PI_CONFIG_DIR=".ompp"

# Point to installed OMP's node_modules for native modules
OMP_HOME="${HOME}/.bun/install/global/node_modules/@oh-my-pi"
export NODE_PATH="${OMP_HOME}:${OMP_HOME}/pi-natives:${OMP_HOME}/pi-ai:${OMP_HOME}/pi-utils:${OMP_HOME}/pi-coding-agent/node_modules"

launch_dir=${OMP_DEV_LAUNCH_DIR:-${HOME}/.ompp/.dev-cwd}
mkdir -p "$launch_dir"

OMP_LAUNCH_CWD=$PWD
export OMP_LAUNCH_CWD
cd "$launch_dir"
exec bun --preload "$preload" "$cli" "$@"
